---
import { getCollection } from "astro:content";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { copy } from "@/copy";
import { getSortedCaseStudies } from "@/utils/caseStudies";
import { pagePath } from "@/utils/withBase";
import config from "@/config";

const { socials, caseStudies: caseStudiesConfig } = config;

const studies = await getCollection("caseStudies");
const sortedStudies = getSortedCaseStudies(studies);
const featuredStudies = sortedStudies.filter(({ data }) => data.featured);
const recentStudies = sortedStudies.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Vishal Tomar
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>[PLACEHOLDER: introduction]</p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {copy.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredStudies.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentStudies.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {copy.home.featured}
          </h2>
          <ul>
            {featuredStudies.map(study => (
              <Card variant="h3" {...study} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentStudies.length > 0 && (
        <section id="recent-case-studies" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {copy.home.recentCaseStudies}
          </h2>
          <ul>
            {recentStudies.slice(0, caseStudiesConfig.perIndex).map(study => (
              <Card variant="h3" {...study} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={pagePath("case-studies")}>
        {copy.home.allCaseStudies}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
