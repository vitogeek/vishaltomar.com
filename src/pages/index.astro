---
import { Picture } from "astro:assets";
import { getEntry, render } from "astro:content";
import portrait from "@/assets/vishal-tomar.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { copy } from "@/copy";
import config from "@/config";

const { site } = config;

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout title={site.title} description={site.description}>
  <Header />
  <main id="main-content" class="app-layout pt-8 pb-4">
    <h1 class="sr-only">Vishal Tomar</h1>
    <div
      class="mb-6 flex flex-col items-start gap-4 [--row:6rem] sm:flex-row sm:items-center sm:gap-6 sm:[--row:8rem]"
    >
      <Picture
        src={portrait}
        alt="Vishal Tomar"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[192, 256]}
        sizes="(min-width: 40rem) 128px, 96px"
        width={256}
        height={256}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        pictureAttributes={{ class: "block size-(--row) shrink-0" }}
        class="block aspect-square size-(--row) shrink-0 rounded-full object-cover"
      />
      <p class="min-w-0 leading-relaxed wrap-break-word">{copy.home.support}</p>
    </div>
    <div class="app-prose [&>:first-child]:mt-0">
      <Content />
    </div>
  </main>
  <Footer />
</Layout>
