---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Figure from "@/components/mdx/Figure.astro";
import Video from "@/components/mdx/Video.astro";
import Callout from "@/components/mdx/Callout.astro";
import PublishedDate from "@/components/PublishedDate.astro";
import {
  caseStudyPath,
  getRelatedCaseStudies,
  getSortedCaseStudies,
} from "@/utils/caseStudies";
import { pagePath } from "@/utils/withBase";
import config from "@/config";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");

  return getSortedCaseStudies(studies).map(study => ({
    params: { slug: study.id },
    props: { study },
  }));
}

interface Props {
  study: CollectionEntry<"caseStudies">;
}

const { study } = Astro.props;
const {
  title,
  summary,
  role,
  timeline,
  stack,
  tags,
  cover,
  coverAlt,
  pubDatetime,
} = study.data;
const { Content } = await render(study);
const studies = await getCollection("caseStudies");
const related = getRelatedCaseStudies(studies, study.id);

const ogImage = config.features.dynamicOgImage
  ? pagePath(`case-studies/${study.id}/index.png`)
  : cover.src;
---

<Layout
  title={`${title} | ${config.site.title}`}
  description={summary}
  {ogImage}
>
  <Header />

  <Breadcrumb />

  <main
    id="main-content"
    class="mx-auto w-full max-w-[72ch] min-w-0 px-4 pt-2 pb-16"
  >
    <article>
      <header>
        <h1
          class="text-3xl font-bold tracking-tight wrap-break-word sm:text-4xl"
        >
          {title}
        </h1>
        <PublishedDate date={pubDatetime} class="mt-3" />
        <p class="mt-4 text-lg leading-relaxed wrap-break-word">{summary}</p>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium">Role</dt>
            <dd class="mt-1 wrap-break-word">{role}</dd>
          </div>
          <div>
            <dt class="text-sm font-medium">Timeline</dt>
            <dd class="mt-1 wrap-break-word">{timeline}</dd>
          </div>
          {
            stack.length > 0 && (
              <div class="sm:col-span-2">
                <dt class="text-sm font-medium">Stack</dt>
                <dd>
                  <ul class="mt-2 flex flex-wrap gap-2">
                    {stack.map(item => (
                      <li class="bg-muted text-foreground rounded-full px-2.5 py-0.5 text-sm wrap-break-word">
                        {item}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            tags.length > 0 && (
              <div class="sm:col-span-2">
                <dt class="text-sm font-medium">Tags</dt>
                <dd>
                  <ul class="mt-2 flex flex-wrap gap-2">
                    {tags.map(tag => (
                      <li class="bg-muted text-foreground rounded-full px-2.5 py-0.5 text-sm wrap-break-word">
                        {tag}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </header>

      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 768, 960]}
        sizes="(min-width: 48rem) 72ch, 100vw"
        class="border-border mt-8 h-auto w-full border"
        loading="eager"
        fetchpriority="high"
      />

      <div class="app-prose mt-8 min-w-0">
        <Content components={{ Figure, Video, Callout }} />
      </div>
    </article>
    {
      related.length > 0 && (
        <section class="mt-16" aria-labelledby="for-you-heading">
          <h2
            id="for-you-heading"
            class="text-2xl font-semibold wrap-break-word sm:text-3xl"
          >
            For you
          </h2>
          <ul class="mt-4 flex flex-col gap-4">
            {related.map(item => (
              <li class="min-w-0">
                <a
                  href={caseStudyPath(item.id)}
                  target="_blank"
                  rel="noopener"
                  class="text-accent text-lg font-medium wrap-break-word decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
                >
                  {item.data.title}
                  <span class="sr-only"> (opens in new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
