---
import type { CollectionEntry } from "astro:content";
import { caseStudyPath } from "@/utils/caseStudies";
import { toTransitionName } from "@/utils/toTransitionName";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"caseStudies">;

const { variant: Heading = "h2", id, data } = Astro.props;
const { title, summary, role, timeline, tags } = data;
---

<li class="my-8">
  <article>
    <a
      href={caseStudyPath(id)}
      class:list={[
        "text-accent inline-block text-lg font-medium",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading transition:name={toTransitionName(id)} class="wrap-break-word">
        {title}
      </Heading>
    </a>
    <p class="mt-2 wrap-break-word">{summary}</p>
    <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium">Role</dt>
        <dd class="wrap-break-word">{role}</dd>
      </div>
      <div>
        <dt class="font-medium">Timeline</dt>
        <dd class="wrap-break-word">{timeline}</dd>
      </div>
    </dl>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map(tag => (
            <li class="bg-muted text-foreground rounded-full px-2.5 py-0.5 text-sm wrap-break-word">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </article>
</li>
