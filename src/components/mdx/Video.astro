---
interface Props {
  src: string;
  caption: string;
  poster?: string;
}

const { src, caption, poster } = Astro.props;
---

<figure class="not-prose my-8">
  <video
    class="border-border h-auto w-full border"
    data-case-video
    width="640"
    height="360"
    muted
    loop
    playsinline
    preload="metadata"
    controls
    poster={poster}
  >
    <source {src} type="video/mp4" />
  </video>
  <figcaption class="text-foreground mt-2 text-sm leading-snug">
    {caption}
  </figcaption>
</figure>

<script>
  // Autoplay only when the user has not asked for reduced motion.
  function initCaseVideos() {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    document.querySelectorAll("[data-case-video]").forEach(node => {
      if (!(node instanceof HTMLVideoElement)) return;

      if (reduceMotion) {
        node.autoplay = false;
        node.controls = true;
        node.pause();
        return;
      }

      node.controls = false;
      node.autoplay = true;
      void node.play().catch(() => {
        node.controls = true;
      });
    });
  }

  initCaseVideos();
  document.addEventListener("astro:page-load", initCaseVideos);
</script>
