---
import {
  calloutClass,
  metricLabelClass,
  metricValueClass,
  quoteAttributionClass,
  quoteTextClass,
  type CalloutModel,
} from "@/utils/calloutMarkup";

type Props = CalloutModel;

const props = Astro.props;
---

{
  props.kind === "metric" ? (
    <div class={calloutClass}>
      <p class={metricValueClass}>{props.value}</p>
      <p class={metricLabelClass}>{props.label}</p>
    </div>
  ) : (
    <figure class={calloutClass}>
      <blockquote>
        <p class={quoteTextClass}>{props.quote}</p>
      </blockquote>
      {props.attribution && (
        <figcaption class={quoteAttributionClass}>
          — {props.attribution}
        </figcaption>
      )}
    </figure>
  )
}
