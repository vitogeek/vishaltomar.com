---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="not-prose my-8">
  <Image
    {src}
    {alt}
    widths={[480, 768, 960]}
    sizes="(min-width: 48rem) 72ch, 100vw"
    class="border-border h-auto w-full border"
  />
  <figcaption class="text-foreground mt-2 text-sm leading-snug">
    {caption}
  </figcaption>
</figure>
