---
import config from "@/config";
import LinkButton from "./LinkButton.astro";

type Props = {
  size?: "sm" | "md";
};

const { size = "md" } = Astro.props;

const sizeStyles = {
  sm: {
    list: "flex flex-nowrap items-center gap-1",
    link: "size-8 justify-center",
    icon: "size-5 fill-transparent stroke-current stroke-2",
  },
  md: {
    list: "flex flex-wrap items-center gap-2",
    link: "size-12 justify-center",
    icon: "size-6 fill-transparent stroke-current stroke-2",
  },
} as const;

const styles = sizeStyles[size];

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    if (!Icon) return null;

    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Send an email to ${site.title}`
        : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);

    return { url, title, Icon };
  })
);

const links = items.filter(item => item !== null);
---

<div class={styles.list}>
  {
    links.map(({ url, title, Icon }) => (
      <LinkButton
        href={url}
        class={styles.link}
        title={title}
        aria-label={title}
      >
        <Icon aria-hidden="true" class={styles.icon} />
      </LinkButton>
    ))
  }
</div>
