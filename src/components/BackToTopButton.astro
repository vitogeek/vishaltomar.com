---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { copy } from "@/copy";
---

<button
  id="back-to-top"
  type="button"
  data-visible="false"
  inert
  aria-label={copy.a11y.backToTop}
  class="border-border bg-background text-foreground hover:bg-muted pointer-events-none fixed end-[calc(1rem+env(safe-area-inset-right,0px))] bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] z-30 inline-flex size-12 translate-y-4 items-center justify-center rounded-full border opacity-0 shadow-lg transition duration-300 data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 motion-reduce:translate-none motion-reduce:transition-none"
>
  <IconArrowNarrowUp aria-hidden="true" class="size-6" />
</button>

<script>
  let boundButton: HTMLButtonElement | null = null;

  function getButton(): HTMLButtonElement | null {
    const button = document.getElementById("back-to-top");
    return button instanceof HTMLButtonElement ? button : null;
  }

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function setShown(button: HTMLButtonElement, shown: boolean): void {
    const state = shown ? "true" : "false";
    if (button.dataset.visible === state) return;
    button.dataset.visible = state;
    button.toggleAttribute("inert", !shown);
  }

  function sync(): void {
    const button = getButton();
    if (!button) return;
    const viewport = window.innerHeight;
    const maxScroll = document.documentElement.scrollHeight - viewport;
    const threshold = Math.min(viewport, Math.max(maxScroll, 0));
    const shown =
      document.activeElement === button ||
      (maxScroll > 0 && window.scrollY >= threshold - 2);
    setShown(button, shown);
  }

  function focusPageTop(): void {
    const target = document.getElementById("main-content");
    if (!target) return;
    const addedTabIndex = !target.hasAttribute("tabindex");
    if (addedTabIndex) target.setAttribute("tabindex", "-1");
    target.focus({ preventScroll: true });
    if (addedTabIndex) {
      target.addEventListener(
        "blur",
        () => {
          target.removeAttribute("tabindex");
        },
        { once: true }
      );
    }
    sync();
  }

  function scrollToTop(): void {
    const behavior: ScrollBehavior = prefersReducedMotion()
      ? "instant"
      : "smooth";
    window.scrollTo({ top: 0, left: 0, behavior });
    focusPageTop();
  }

  function setup(): void {
    const button = getButton();
    if (!button) return;
    if (boundButton !== button) {
      button.addEventListener("click", scrollToTop);
      boundButton = button;
    }
    sync();
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
  window.addEventListener("scroll", sync, { passive: true });
</script>
